# ============ Supabase (https://supabase.com > Project Settings > API) ============
# NE JAMAIS committer de vraies clés dans ce fichier.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ============ Sécurité interne ============
# Clé partagée entre Next.js / n8n et le moteur. Générer :
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Clé Fernet pour chiffrer les tokens OAuth en base. Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============ Google Calendar API (console.cloud.google.com) ============
# Dans "Identifiants > ID client OAuth", ajouter comme URI de redirection :
#   ${SITE_URL}/api/google/callback   (ex: http://localhost:3000/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique du frontend (utilisée pour la redirection OAuth)
SITE_URL=http://localhost:3000

# ============ n8n (derrière Cloudflare Tunnel) ============
N8N_HOST=automation.domaine.com

# ============ Production uniquement (docker-compose.prod.yml) ============
# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels > ton tunnel > token)
TUNNEL_TOKEN=

# ===========================================================
# Conseiller IA local (Ollama). Optionnel : défaut qwen3:4b-instruct-2507-q4_K_M (Apache 2.0).
# Changer de modèle : modifier puis `docker compose ... up -d llm-init`.
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
