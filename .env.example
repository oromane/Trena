# ============ Sécurité interne ============
# Clé partagée entre Next.js / n8n et le moteur. Générer :
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Clé Fernet pour chiffrer les tokens OAuth en base. Générer :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ============ Google Calendar API (console.cloud.google.com) ============
# Dans "Identifiants > ID client OAuth", ajouter comme URI de redirection :
#   ${SITE_URL}/api/google/callback   (ex: http://localhost:3000/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique du frontend (utilisée pour la redirection OAuth)
SITE_URL=http://localhost:3000

# ============ n8n (derrière Cloudflare Tunnel) ============
N8N_HOST=automation.domaine.com
